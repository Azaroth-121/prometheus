# dependencies
node_modules/
.pnpm-store/

# build outputs
.next/
dist/
build/
.turbo/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# extension build artifacts
apps/extension/.output/
apps/extension/*.zip
*.zip
# the natural default extraction target for prometheus-extension.zip — keep
# it out of the source tree entirely (it broke `eslint .` once already)
apps/extension/prometheus-extension/

# extension signing key -- the private half of manifest.json's "key" field
# (pins the Chrome extension's stable ID). Losing this file means losing
# that ID permanently; never commit it. See apps/extension/.keys/README.md.
apps/extension/.keys/*.pem

# editor/os
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# deploy script gets real secrets pasted into it locally -- never commit
deploy.ps1
