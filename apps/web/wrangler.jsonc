// Cloudflare Workers config for the Prometheus web app + API (OpenNext adapter).
// Migration plan: SoverAIgn-Solutions/organizational-singularity docs/migration/cloudflare.md §6.
// Azure stays the live host until cutover; nothing here is deployed by CI yet.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prometheus-web",
  // Custom entry: wraps the OpenNext handler and adds the daily cron (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "prometheus-web"
    }
  ],
  // Served at https://prometheus-web.steven-palange.workers.dev until soveraign.solutions moves
  // to Cloudflare DNS (its nameservers are still at Network Solutions); then add a custom-domain
  // route and change NEXT_PUBLIC_APP_URL (and the extension's API URL) to it.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://prometheus-web.steven-palange.workers.dev"
  },
  // Postgres through Hyperdrive config `prometheus-db` -> Neon project `prometheus`
  // (old-queen-46998133, Soveraign org, Singapore). Query caching is DISABLED on that config
  // (wrangler hyperdrive update <id> --caching-disabled true): cached reads served stale logins,
  // revoked tokens and usage counts. localConnectionString is only for `wrangler dev`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3e3a29704d3040708d3b17190331ca5d",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/prometheus"
    }
  ],
  // Will replace the Azure Container Apps job caj-prom-expiry-dev-eus2-01 (daily 13:00 UTC).
  // Off until cutover: while Azure's job still runs, both would email the same users.
  // After cutover set this to ["0 13 * * *"].
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  },
  // QA environment: a separate Worker + database for demo and QA testers (15-20 people).
  // Deploy with `--env qa`. Its own secrets (generated fresh, NOT production values), Stripe
  // in TEST mode, Neon free Postgres behind its own Hyperdrive config, and no cron, so testers
  // never get billing emails. Production users stay on Azure until the real cutover.
  "env": {
    "qa": {
      "name": "prometheus-qa",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "prometheus-qa"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // Set after `wrangler hyperdrive create prometheus-qa-db ...` (QA setup, step 4).
          "id": "00000000000000000000000000000000",
          "localConnectionString": "postgresql://postgres:postgres@localhost:5432/prometheus"
        }
      ],
      "triggers": {
        "crons": []
      },
      "vars": {
        "NEXT_PUBLIC_APP_URL": "https://prometheus-qa.soveraign.solutions"
      },
      "routes": [
        {
          "pattern": "prometheus-qa.soveraign.solutions",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
  // Secrets are set with `wrangler secret put` (never committed), copied UNCHANGED from the
  // current Azure app settings: AUTH_SECRET, EXTENSION_JWT_SECRET, CRON_SECRET,
  // STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, OPENAI_API_KEY, MAKE_EXPIRY_WEBHOOK_URL,
  // MAKE_VERIFICATION_WEBHOOK_URL, MAKE_ORGANIZATION_INVITE_WEBHOOK_URL.
  // NEXT_PUBLIC_APP_URL is set per environment. The Postgres password is new on PlanetScale
  // and lives in the Hyperdrive config, not here.
}
