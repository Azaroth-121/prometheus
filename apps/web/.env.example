# Postgres connection string (see packages/database) -- Drizzle + plain
# Postgres, not Supabase (migrated off Supabase entirely, see
# documentation/architecture/implementation-notes.md).
DATABASE_URL=postgres://user:password@localhost:5432/prometheus

# NextAuth's session-cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Signs the extension's self-issued access/refresh token pair -- separate
# from AUTH_SECRET so the two token systems can be rotated independently.
# Generate with: openssl rand -base64 32
EXTENSION_JWT_SECRET=

OPENAI_API_KEY=

# Stripe -- use a sk_test_... key for local dev. No separate sandbox host:
# test vs live is determined entirely by which secret key is configured.
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/stripe. For local dev, run
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and use
# the whsec_... it prints; for a deployed environment, create a webhook
# endpoint in the Stripe Dashboard pointed at that URL instead.
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the /api/cron/expiry-reminders route checks on its caller.
CRON_SECRET=

# Make.com scenario webhook URLs -- send the sign-up verification email and
# the subscription-expiry reminder email, respectively.
MAKE_EXPIRY_WEBHOOK_URL=
MAKE_VERIFICATION_WEBHOOK_URL=
# Emails an organization's owner and billing managers when its shared usage
# reaches 80% or 100%. Unset: alerts are recorded but not emailed.
MAKE_USAGE_ALERT_WEBHOOK_URL=

# Optional -- fires a notification (name/email/phone/company/referral
# source) on every new sign-up if set. Sign-up succeeds either way if this
# is unset or the request fails; it's a nice-to-have, not load-bearing.
MAKE_SIGNUP_NOTIFICATION_WEBHOOK_URL=
