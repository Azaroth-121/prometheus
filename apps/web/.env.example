# Public — safe to expose to the browser (RLS protects the data behind the anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_, never commit real values
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# PayPal — apiBase is https://api-m.paypal.com (live) or https://api-m.sandbox.paypal.com (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
# Left blank until a webhook is registered against a publicly reachable URL
PAYPAL_WEBHOOK_ID=
