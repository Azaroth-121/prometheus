{
  "manifest_version": 3,
  "name": "Prometheus",
  "version": "0.1.0",
  "description": "Turn a rough request into a structured, copy-ready prompt.",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Prometheus"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://ca-prometheus-web-dev-eus2-01.delightfulcliff-8cc5b938.eastus2.azurecontainerapps.io/*"
  ]
}
